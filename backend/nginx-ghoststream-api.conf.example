# Add inside the existing ghoststreams.ink HTTPS server block.
# No trailing slash on proxy_pass: preserve /api/v1/... exactly.
location ^~ /api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_pass http://ghoststream-api:8098;
}

# Optional service-specific health endpoint for operations.
location = /ghoststream-api-health {
    proxy_set_header Host $host;
    proxy_pass http://ghoststream-api:8098/health;
}
